# 统一换行符:源码/文本一律 LF,避免 WSL(CRLF↔LF) 与 Windows 间无谓 diff
* text=auto

*.java text eol=lf
*.groovy text eol=lf
*.json text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.cfg text eol=lf
*.png binary
*.jar binary
gradlew text eol=lf
gradlew.bat text eol=crlf
# Windows 批处理：**必须 CRLF**（LF + 中文会被 cmd.exe 按 GBK 误读并断错行，实测）
*.cmd text eol=crlf
*.bat text eol=crlf
