+/**
+ * P0 pure gate logic for the agent-bus reliability work.
+ *
+ * These are the side-effect-free decision functions behind the P0 required-
+ * skills gate and the evidence-state validator. They are split out (rather
+ * than remaining private inside tools.ts) so they can be unit-tested in
+ * isolation without loading the cordis/web runtime. No tool registration, no
+ * I/O, no state mutation lives here.
+ *
+ * @module dsh-agent-bus/p0-gates
+ */
+
+import type { TaskRecord } from './types.ts'
+
+/** A skill registered in the project's skills-manifest.yml. */
+export interface SkillManifestEntry {
+  readonly id: string
+  readonly status: 'draft' | 'maintainer-approved' | 'deprecated' | 'revoked'
+  readonly version?: string
+}
+export type SkillsManifest = readonly SkillManifestEntry[]
+
+/** A transition rule from the project's state-machine.yml. */
+export type StateMachineRule = { readonly from: string; readonly to: string }
+export type StateMachineRules = readonly StateMachineRule[]
+
+/** Result of a required-skill audit. */
+export type AuditResult =
+  | { readonly ok: true; readonly usage: { id: string; version: string; loadedAt: string; exception?: boolean }[] }
+  | { readonly ok: false; readonly message: string }
+
+/** Parse a skill status string into the closed set. */
+export function parseSkillStatus(value: string): SkillManifestEntry['status'] {
+  if (value === 'maintainer-approved' || value === 'deprecated' || value === 'revoked') return value
+  return 'draft'
+}
+
+/** Compare two dotted-semver strings. Returns -1/0/1. */
+export function compareVersions(a: string, b: string): number {
+  const pa = a.split('.').map(x => parseInt(x, 10) || 0)
+  const pb = b.split('.').map(x => parseInt(x, 10) || 0)
+  for (let i = 0; i < 3; i++) {
+    const da = pa[i] ?? 0
+    const db = pb[i] ?? 0
+    if (da !== db) return da < db ? -1 : 1
+  }
+  return 0
+}
+
+/**
+ * Parse a skills-manifest.yml body into entries. Narrow parser for the fixed
+ * shape the project defines (`- id: <id>` / `  status: <status>` /
+ * `  version: <v>`); not a general YAML loader.
+ */
+export function parseSkillsManifest(text: string): SkillsManifest {
+  const entries: SkillManifestEntry[] = []
+  let current: SkillManifestEntry | undefined
+  for (const raw of text.split('\n')) {
+    const line = raw.replace(/\r$/, '')
+    const idMatch = line.match(/^\s*-\s+id:\s*(.+)$/)
+    if (idMatch) {
+      if (current !== undefined) entries.push(current)
+      current = { id: (idMatch[1] ?? '').trim(), status: 'draft' }
+      continue
+    }
+    if (current === undefined) continue
+    const statusMatch = line.match(/^\s+status:\s*(.+)$/)
+    if (statusMatch) {
+      current = { ...current, status: parseSkillStatus((statusMatch[1] ?? '').trim()) }
+      continue
+    }
+    const versionMatch = line.match(/^\s+version:\s*(.+)$/)
+    if (versionMatch) current = { ...current, version: (versionMatch[1] ?? '').trim() }
+  }
+  if (current !== undefined) entries.push(current)
+  return entries
+}
+
+/** Parse a state-machine.yml body into transition rules. */
+export function parseStateMachine(text: string): StateMachineRules {
+  const rules: StateMachineRule[] = []
+  let current: StateMachineRule | undefined
+  for (const raw of text.split('\n')) {
+    const line = raw.replace(/\r$/, '')
+    const fromMatch = line.match(/^\s*-\s+from:\s*(.+)$/)
+    if (fromMatch) {
+      if (current !== undefined) rules.push(current)
+      current = { from: (fromMatch[1] ?? '').trim(), to: '' }
+      continue
+    }
+    if (current === undefined) continue
+    const toMatch = line.match(/^\s+to:\s*(.+)$/)
+    if (toMatch) current = { from: current.from, to: (toMatch[1] ?? '').trim() }
+  }
+  if (current !== undefined && current.to !== '') rules.push(current)
+  return rules
+}
+
+/** Whether a from->to transition is explicitly allowed by the ruleset. */
+export function isTransitionAllowed(rules: StateMachineRules, from: string, to: string): boolean {
+  return rules.some(r => r.from === from && r.to === to)
+}
+
+/**
+ * Audit a worker's skill_usage against a task's required_skills and the
+ * manifest. A required skill is satisfied when the worker registered a usage
+ * record for it AND the manifest marks it maintainer-approved AND its
+ * min_version (if any) is met — OR when the task pre-records a
+ * skill_exception (initiator/reviewer exemption). A draft/deprecated/revoked
+ * skill never satisfies. This is an audit claim, not proof of reading.
+ */
+export function auditRequiredSkills(
+  task: TaskRecord,
+  usageInput: readonly { id: string; version?: string; loaded_at?: string }[] | undefined,
+  manifest: SkillsManifest,
+): AuditResult {
+  const required = task.requiredSkills ?? []
+  const used = usageInput ?? []
+  const exceptions = task.skillExceptions ?? []
+  const usage: { id: string; version: string; loadedAt: string; exception?: boolean }[] = []
+  for (const req of required) {
+    const exempted = exceptions.some(ex => ex.skillId === req.id)
+    const entry = manifest.find(m => m.id === req.id)
+    if (!exempted) {
+      const rec = used.find(u => u.id === req.id)
+      if (rec === undefined) {
+        return { ok: false, message: `required skill "${req.id}" was not registered in skill_usage` }
+      }
+      if (entry === undefined) {
+        return { ok: false, message: `skill "${req.id}" is not in the project skills-manifest.yml` }
+      }
+      if (entry.status !== 'maintainer-approved') {
+        return { ok: false, message: `skill "${req.id}" is ${entry.status}; only maintainer-approved skills satisfy required_skills` }
+      }
+      if (req.minVersion !== undefined && entry.version !== undefined) {
+        if (compareVersions(String(entry.version), req.minVersion) === -1) {
+          return { ok: false, message: `skill "${req.id}" version ${entry.version} does not meet required min_version ${req.minVersion}` }
+        }
+      }
+      const approved = rec.version ?? entry.version ?? ''
+      usage.push({ id: req.id, version: approved, loadedAt: rec.loaded_at ?? new Date().toISOString() })
+    } else {
+      const rec = used.find(u => u.id === req.id)
+      usage.push({ id: req.id, version: rec?.version ?? entry?.version ?? '', loadedAt: rec?.loaded_at ?? new Date().toISOString(), exception: true })
+    }
+  }
+  return { ok: true, usage }
+}
