+
+/**
+ * Load the project skills-manifest.yml at `<workspacePath>/.alice-supervision/`.
+ * Absent or unparsable -> empty manifest. Delegates parsing to p0-gates.
+ */
+export async function loadSkillsManifest(workspacePath: string): Promise<SkillsManifest> {
+  const p = join(workspacePath, '.alice-supervision', 'skills-manifest.yml')
+  const text = await readFile(p, 'utf8').catch(() => '')
+  if (text === '') return []
+  return parseSkillsManifest(text)
+}
+
+/**
+ * Load the project evidence state-machine.yml at `<workspacePath>/.alice-supervision/`.
+ * Absent -> empty rules. Delegates parsing to p0-gates.
+ */
+export async function loadStateMachine(workspacePath: string): Promise<StateMachineRules> {
+  const p = join(workspacePath, '.alice-supervision', 'state-machine.yml')
+  const text = await readFile(p, 'utf8').catch(() => '')
+  if (text === '') return []
+  return parseStateMachine(text)
+}
