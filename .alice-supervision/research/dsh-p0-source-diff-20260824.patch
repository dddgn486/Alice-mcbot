+        `- operator: ${args.operator ?? callerId}`,
+        `- source_commit: ${args.source_commit}`,
+        `- target_path: ${args.target_path}`,
+        `- sha256: ${args.sha256}`,
+        `- reason: ${args.reason}`,
+        `- recovery_plan: ${args.recovery_plan}`,
