+
+/** Run a git command in a workspace dir without treating stderr as status output. */
+async function runGit(cwd: string, args: string[]): Promise<{ ok: boolean; output: string; error?: string }> {
+  const exec = promisify(execFile)
+  try {
+    const { stdout, stderr } = await exec('git', args, { cwd })
+    return { ok: true, output: stdout, ...(stderr.trim() !== '' ? { error: stderr.trim() } : {}) }
+  } catch (err) {
+    const e = err as { message?: string; stderr?: string }
+    return { ok: false, output: '', error: e.stderr?.trim() || e.message || 'git command failed' }
+  }
+}
+
+/** List emergency-record filenames in `<workspacePath>/.alice-supervision/emergency/`. */
+async function listEmergency(workspacePath: string): Promise<string[]> {
+  const dir = join(workspacePath, '.alice-supervision', 'emergency')
+  const entries = await readdir(dir).catch(() => [] as string[])
+  return entries.filter(n => n.endsWith('.md'))
+}
